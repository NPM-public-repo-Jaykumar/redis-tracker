{
  "name": "redis-tracker",
  "version": "3.0.7",
  "description": "Redis based RPC tracking counters",
  "author": "codezeros",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NPM-public-repo-Jaykumar/redis-tracker.git"
  },
  "homepage": "https://github.com/NPM-public-repo-Jaykumar/redis-tracker#readme",
  "bugs": {
    "url": "https://github.com/NPM-public-repo-Jaykumar/redis-tracker/issues"
  },
  "keywords": [
    "redis",
    "tracker",
    "metrics",
    "analytics",
    "rpc",
    "typescript",
    "jkg",
    "jaykumar-gohil"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "SKILL.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && node scripts/copy-assets.js dist && node scripts/obfuscate-dist.js",
    "build:plain": "tsc && node scripts/copy-assets.js dist",
    "test": "tsc -p tsconfig.test.json && node scripts/copy-assets.js .test-build/src && node --test --test-concurrency=1 \".test-build/test/*.test.js\"",
    "prepublishOnly": "npm run release:check && npm run release:bump && npm run build && npm run prepublish-release",
    "postpublish": "npm run postpublish-release && npm run public-postpublish-release",
    "prepublish-release": "node scripts/prepublish-release.js",
    "postpublish-release": "node scripts/postpublish-release.js",
    "public-postpublish-release": "node scripts/public-postpublish-release.js",
    "release:bump": "node scripts/bump-version.js",
    "release:check": "test \"$(git rev-parse --abbrev-ref HEAD)\" = main || { echo \"Release from the main branch\"; exit 1; }; npm owner ls \"$npm_package_name\" 2>/dev/null | grep -q \"^$(npm whoami 2>/dev/null) \" || { echo \"Log in to npm (npm login) as an owner of $npm_package_name first\"; exit 1; }"
  },
  "dependencies": {
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "express": "^5.3.0",
    "javascript-obfuscator": "^5.9.0",
    "socket.io": "^4.8.4",
    "typescript": "^5.9.3",
    "ws": "^8.22.0"
  }
}
